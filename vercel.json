{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/upload/:path*",
      "destination": "/",
      "statusCode": 410
    }
  ],
  "headers": [
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://china3agames.com"
        }
      ]
    }
  ]
}